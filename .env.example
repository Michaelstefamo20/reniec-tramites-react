# Development Gmail SMTP. SMTP_PASS is a Google App Password, never your regular Gmail password.
NODE_ENV=development
API_PORT=4176
VITE_PORT=5177
APP_BASE_URL=http://localhost:5177
DATABASE_URL=postgresql://appuser:[REDACTED]@127.0.0.1:5432/reniec_app
DATABASE_SSL=false
POSTGRES_PASSWORD=change_me
DNI_ENCRYPTION_KEY=
DNI_HASH_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=
MAIL_FROM=your-sender@gmail.com
