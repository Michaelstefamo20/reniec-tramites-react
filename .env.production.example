# Configure in Vercel Project Settings > Environment Variables. Never commit actual secret values.
NODE_ENV=production
# Optional in Vercel: if omitted, the activation links use Vercel's deployment URL.
APP_BASE_URL=https://your-project.vercel.app
# Use an externally reachable managed PostgreSQL URL with TLS, not Docker's internal hostname.
DATABASE_URL=postgresql://USER:[REDACTED]@YOUR_MANAGED_POSTGRES_HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DNI_ENCRYPTION_KEY=
DNI_HASH_KEY=
# Gmail SMTP sender account. SMTP_PASS is the sender account's Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@gmail.com
SMTP_PASS=
MAIL_FROM=sender@gmail.com
# Optional Claude API key for the virtual assistant; usage has separate API limits/billing.
ANTHROPIC_API_KEY=
